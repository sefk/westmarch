# Copy to .env. Everything is optional; a loader whose credentials are
# blank reports itself disabled instead of failing.
WESTMARCH_PORT=8520
GRAFANA_PORT=3520
# DJANGO_DEBUG=true
# GITHUB_TOKEN=            # defaults to `gh auth token` when blank
# OPENROUTER_API_KEY=       # credits and budget snapshots; blank disables
# WESTMARCH_RAW_DIR=/Volumes/ext1/westmarch   # raw mail and health payloads
# HEALTH_INGEST_TOKEN=      # shared secret for /ingest/health/; blank disables
# LOCATION_INGEST_TOKEN=    # Overland access token for /ingest/location/; blank disables
# GOOGLE_CLIENT_FILE=       # default secrets/google-client.json (Desktop OAuth client)
# GOOGLE_TOKEN_FILE=        # default secrets/google-token.json, written by `manage.py google_auth`
# IMESSAGE_SNAPSHOT_BIN=    # default var/bin/imessage-snapshot (bin/build-imessage-snapshot)
# IMESSAGE_SNAPSHOT=        # default $WESTMARCH_RAW_DIR/imessage/chat.db, the helper's copy
# IMESSAGE_DB=              # read this chat.db directly, skipping the helper (needs FDA for Python)
# GMAIL_UNITS_PER_MINUTE=6000   # 15000 for a Cloud project older than 2026-05-01
# GMAIL_GET_RAW_UNITS=60        # 5 for such a project

# mailindex: hourly indexing of mail text (after the first manage.py mailindex backfill)
# MAILINDEX_ENABLED=1
# The local model server every mail pass uses (loopback only). LM Studio by
# default; ds4 is http://127.0.0.1:8765/v1 with qwen3.8-flash-next.
# LOCAL_LLM_URL=http://127.0.0.1:1234/v1
# LOCAL_LLM_MODEL=qwen/qwen3.6-35b-a3b
# MAILINDEX_OCR_URL= / MAILINDEX_OCR_MODEL=    # default LOCAL_LLM_*
# maildigest: thread summaries; mailvec: embeddings for search by meaning
# MAILDIGEST_ENABLED=1
# MAILDIGEST_MODEL=                            # default LOCAL_LLM_MODEL
# MAILVEC_ENABLED=1
# MAILVEC_MODEL=text-embedding-nomic-embed-text-v1.5
# MAILVEC_SCOPE=personal                       # or all
