# Copy to .env. Everything is optional; a loader whose credentials are
# blank reports itself disabled instead of failing.
LIFE_PORT=8520
GRAFANA_PORT=3520
# DJANGO_DEBUG=true
# GITHUB_TOKEN=            # defaults to `gh auth token` when blank
# OPENROUTER_API_KEY=       # credits and budget snapshots; blank disables
# LIFE_RAW_DIR=/Volumes/ext1/life-metrics   # raw mail and health payloads
# HEALTH_INGEST_TOKEN=      # shared secret for /ingest/health/; blank disables
# GOOGLE_CLIENT_FILE=       # default secrets/google-client.json (Desktop OAuth client)
# GOOGLE_TOKEN_FILE=        # default secrets/google-token.json, written by `manage.py google_auth`
# IMESSAGE_DB=              # default ~/Library/Messages/chat.db
