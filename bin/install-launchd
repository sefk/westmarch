#!/usr/bin/env bash
# Render ops/launchd/*.plist.in and install them: the web server and the
# hourly/daily loader jobs as system LaunchDaemons that run as this user
# (start at boot, nobody logged in; needs sudo), and the "session" loader
# job as a per-user LaunchAgent in gui/<uid> (needs the login Keychain, so
# it only runs while you are logged in; no sudo). Re-running replaces the
# loaded jobs.
#
#   bin/install-launchd            everything
#   bin/install-launchd --agent    only the LaunchAgent (no sudo)
#   PLIST_DEST=/some/dir bin/install-launchd   only render, don't install
set -euo pipefail
. "$(dirname "$0")/_common.sh"
cd "$ROOT"
ensure_env
user_name="$(id -un)"; group_name="$(id -gn)"

render() {  # label dest
  sed -e "s|@ROOT@|$ROOT|g" -e "s|@HOME@|$HOME|g" -e "s|@LOG_DIR@|$LOG_DIR|g" \
      -e "s|@USER@|$user_name|g" -e "s|@GROUP@|$group_name|g" \
      "$ROOT/ops/launchd/$1.plist.in" > "$2"
  plutil -lint "$2" >/dev/null
}

bootstrap() {  # domain plist [sudo]
  # bootout is asynchronous; bootstrap fails with "5: Input/output error" until it finishes.
  for attempt in 1 2 3 4 5; do
    ${3:-} launchctl bootstrap "$1" "$2" 2>/dev/null && return
    [ "$attempt" = 5 ] && { echo "bootstrap failed for $2" >&2; exit 1; }
    sleep 1
  done
}

if [ "${1:-}" != "--agent" ]; then
  for label in "${LABELS[@]}"; do
    if [ -n "${PLIST_DEST:-}" ]; then
      render "$label" "$PLIST_DEST/$label.plist"; echo "rendered $PLIST_DEST/$label.plist"; continue
    fi
    tmp="$(mktemp)"; render "$label" "$tmp"
    sudo launchctl bootout "$SYS/$label" 2>/dev/null || true
    sudo install -o root -g wheel -m 644 "$tmp" "$DAEMONS_DIR/$label.plist"
    rm -f "$tmp"
    bootstrap "$SYS" "$DAEMONS_DIR/$label.plist" sudo
    echo "loaded $label (system)"
  done
fi

for label in "${AGENT_LABELS[@]}"; do
  if [ -n "${PLIST_DEST:-}" ]; then
    render "$label" "$PLIST_DEST/$label.plist"; echo "rendered $PLIST_DEST/$label.plist"; continue
  fi
  mkdir -p "$AGENTS_DIR"
  launchctl bootout "$GUI/$label" 2>/dev/null || true
  render "$label" "$AGENTS_DIR/$label.plist"
  bootstrap "$GUI" "$AGENTS_DIR/$label.plist"
  echo "loaded $label ($GUI)"
done
